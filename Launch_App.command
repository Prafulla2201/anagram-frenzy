#!/bin/bash
# ============================================================================
# Turnkey Double-Click Launcher for: build a simple game where the user enters any English word, 
# Generated by Agentic SD Team v3
# ============================================================================
cd "$(dirname "$0")"
APP_ROOT="$(pwd)"

# Clear macOS quarantine attribute if copied/downloaded from browser
xattr -dr com.apple.quarantine "$APP_ROOT" 2>/dev/null || true

echo "============================================================"
echo "🚀 Launching: build a simple game where the user enters any English word, "
echo "📂 Directory: $APP_ROOT"
echo "============================================================"

# 1. If placed at project root (containing versions/), step into latest version directory
if [ -d "$APP_ROOT/versions" ]; then
    LATEST_VER=$(ls -1 "$APP_ROOT/versions" | sort -V | tail -n 1)
    if [ -n "$LATEST_VER" ] && [ -d "$APP_ROOT/versions/$LATEST_VER" ]; then
        echo "📌 Selecting latest version: $LATEST_VER"
        cd "$APP_ROOT/versions/$LATEST_VER"
        APP_ROOT="$(pwd)"
    fi
fi

# 2. Resolve Python interpreter with Flask installed (or bootstrap local .venv automatically)
PYTHON_BIN=""
for candidate in \
    "$APP_ROOT/.venv/bin/python" \
    "$APP_ROOT/../../.venv/bin/python" \
    "$APP_ROOT/../../../.venv/bin/python" \
    "$APP_ROOT/../../../../.venv/bin/python" \
    "/opt/homebrew/bin/python3" \
    "/usr/local/bin/python3" \
    "$(which python3)"; do
    if [ -x "$candidate" ] && "$candidate" -c "import flask" >/dev/null 2>&1; then
        PYTHON_BIN="$candidate"
        break
    fi
done

if [ -z "$PYTHON_BIN" ]; then
    SYS_PY="$(which python3)"
    if [ -z "$SYS_PY" ]; then
        echo "❌ Error: Python 3 is required but was not found on PATH."
        read -p "Press Enter to close..."
        exit 1
    fi
    echo "📦 First-time standalone setup: Creating local virtual environment (.venv)..."
    "$SYS_PY" -m venv "$APP_ROOT/.venv"
    "$APP_ROOT/.venv/bin/pip" install --quiet --upgrade pip
    if [ -f "$APP_ROOT/requirements.txt" ]; then
        "$APP_ROOT/.venv/bin/pip" install --quiet -r "$APP_ROOT/requirements.txt" || "$APP_ROOT/.venv/bin/pip" install --quiet flask requests
    else
        "$APP_ROOT/.venv/bin/pip" install --quiet flask requests
    fi
    PYTHON_BIN="$APP_ROOT/.venv/bin/python"
fi

echo "🐍 Using Python: $PYTHON_BIN"

# 3. Locate runnable entrypoint
ENTRYPOINT=""
ENTRYPOINT_DIR="$APP_ROOT"

for candidate in \
    "src/app.py" \
    "src/anatomy_explorer/app.py" \
    "src/game/app.py" \
    "app.py" \
    "src/main.py" \
    "main.py"; do
    if [ -f "$APP_ROOT/$candidate" ]; then
        ENTRYPOINT="$APP_ROOT/$candidate"
        ENTRYPOINT_DIR="$(dirname "$ENTRYPOINT")"
        break
    fi
done

if [ -z "$ENTRYPOINT" ]; then
    FOUND=$(find "$APP_ROOT" -maxdepth 3 \( -name "app.py" -o -name "main.py" \) | head -n 1)
    if [ -n "$FOUND" ]; then
        ENTRYPOINT="$FOUND"
        ENTRYPOINT_DIR="$(dirname "$ENTRYPOINT")"
    else
        echo "❌ Could not find runnable app.py or main.py in $APP_ROOT"
        read -p "Press Enter to close..."
        exit 1
    fi
fi

# 4. Check if this is a Web Server (Flask/FastAPI/HTTP) or interactive CLI
if grep -qiE "flask|fastapi|uvicorn|http\.server" "$ENTRYPOINT"; then
    export PORT=5001
    STALE_PID=$(lsof -ti :$PORT 2>/dev/null)
    if [ -n "$STALE_PID" ]; then
        echo "♻️  Stopping previous process on port $PORT (PID: $STALE_PID)..."
        kill -9 $STALE_PID 2>/dev/null || true
        sleep 0.4
    fi

    export PYTHONPATH="$APP_ROOT:$APP_ROOT/src:$ENTRYPOINT_DIR:$PYTHONPATH"
    cd "$ENTRYPOINT_DIR"
    echo "🌐 Starting Web Server on http://127.0.0.1:$PORT ..."

    (
        for _ in $(seq 1 25); do
            if curl -s "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 || curl -s "http://127.0.0.1:$PORT/" >/dev/null 2>&1; then
                open "http://127.0.0.1:$PORT"
                exit 0
            fi
            sleep 0.3
        done
        open "http://127.0.0.1:$PORT"
    ) &

    "$PYTHON_BIN" "$(basename "$ENTRYPOINT")"
    EXIT_CODE=$?
    if [ $EXIT_CODE -ne 0 ]; then
        echo "❌ Server exited with code $EXIT_CODE."
        read -p "Press Enter to close..."
    fi
else
    export PYTHONPATH="$APP_ROOT:$APP_ROOT/src:$ENTRYPOINT_DIR:$PYTHONPATH"
    cd "$ENTRYPOINT_DIR"
    echo "🖥️  Starting Interactive CLI Application..."
    "$PYTHON_BIN" "$(basename "$ENTRYPOINT")"
    echo ""
    read -p "Application finished. Press Enter to close..."
fi
